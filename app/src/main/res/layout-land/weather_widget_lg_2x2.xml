<?xml version="1.0" encoding="utf-8"?>
<!-- LG Optimus weather widget (com.lge.sizechangable.weather.theme.optimus,
     layout-land/weather_widget_2x2_normal.xml), converted to plain RemoteViews views. -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:id="@+id/lg_root" android:layout_width="match_parent" android:layout_height="match_parent">
    <RelativeLayout android:id="@+id/lg_RelativeLayoutBGSmall" android:visibility="visible" android:layout_width="match_parent" android:layout_height="match_parent">
        <ImageView android:id="@+id/lg_imgBg1" android:layout_width="match_parent" android:layout_height="match_parent" android:scaleType="fitXY" />
        <TextView android:textAppearance="@style/lg_widget_weather_widget_page" android:gravity="center_vertical" android:id="@+id/lg_txt_currentCityIndex" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/lg_mw_animation_arrow_s_marginTop" android:layout_marginRight="@dimen/lg_animation_arrow_s_marginRight" android:layout_alignParentRight="true" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" android:fontFamily="sans-serif-condensed" />
        <RelativeLayout android:id="@+id/lg_widget_city_name_layout" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/lg_TextCitySmall_marginLeft" android:layout_marginTop="@dimen/lg_weather_small_city_name_layout_marginTop" android:layout_toLeftOf="@+id/lg_txt_currentCityIndex">
            <ImageView android:id="@+id/lg_widget_current_img" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/lg_weather_small_current_img_marginTop" />
            <TextView android:textAppearance="@style/lg_widget_weather_widget_s_cityname" android:ellipsize="marquee" android:id="@+id/lg_widget_city_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/lg_widget_city_name_marginRight" android:maxLines="1" android:scrollHorizontally="true" android:singleLine="true" android:layout_toRightOf="@+id/lg_widget_current_img" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" android:fontFamily="sans-serif-condensed" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/lg_widget_no_city" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/lg_widget_small_no_city_marginLeft" android:layout_marginRight="@dimen/lg_widget_small_no_city_marginRight" android:layout_centerInParent="true">
            <TextView android:textAppearance="@style/lg_widget_weather_widget_tabto" android:gravity="center_horizontal" android:id="@+id/lg_widget_no_city_string" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerHorizontal="true" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" android:fontFamily="sans-serif-condensed" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/lg_loading_layout" android:padding="15dp" android:visibility="gone" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_centerInParent="true">
            <ProgressBar android:id="@+id/lg_loading_progress" android:layout_width="25dp" android:layout_height="25dp" android:layout_centerVertical="true" />
            <TextView android:textAppearance="@style/lg_widget_weather_widget_loading" android:id="@+id/lg_loading_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_toRightOf="@+id/lg_loading_progress" android:layout_centerVertical="true" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" android:fontFamily="sans-serif-condensed" />
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout android:id="@+id/lg_widget_tempreture_dataLayout" android:layout_width="match_parent" android:layout_height="match_parent">
        <RelativeLayout android:id="@+id/lg_widget_tempreture_inner_dataLayout" android:visibility="visible" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/lg_RelativeLayoutGrass_marginLeft" android:layout_marginTop="@dimen/lg_RelativeLayoutGrass_marginTop">
            <TextView android:textAppearance="@style/lg_widget_weather_widget_s_current_temp" android:id="@+id/lg_widget_current_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/lg_weather_widget_small_current_temp_marginTop" android:includeFontPadding="false" android:layout_below="@+id/lg_widget_city_name" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" android:fontFamily="sans-serif-condensed" />
            <TextView android:textAppearance="@style/lg_widget_weather_widget_s_weather_state" android:ellipsize="marquee" android:id="@+id/lg_widget_weatherState" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/lg_weather_widget_small_weatherState_marginLeft" android:layout_marginTop="@dimen/lg_weather_widget_small_weatherState_marginTop" android:maxLines="1" android:scrollHorizontally="true" android:singleLine="true" android:layout_below="@+id/lg_widget_current_temp" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" android:fontFamily="sans-serif-condensed" />
            <TextView android:textAppearance="@style/lg_widget_weather_widget_s_hl_temp" android:ellipsize="marquee" android:id="@+id/lg_widget_HL_temp" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginLeft="@dimen/lg_weather_widget_small_weatherState_marginLeft" android:layout_marginTop="@dimen/lg_weather_widget_small_TextMaxTempSmall_marginTop" android:maxLines="1" android:singleLine="true" android:layout_below="@+id/lg_widget_weatherState" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" android:fontFamily="sans-serif-condensed" />
            <ImageView android:id="@+id/lg_widget_warning_icon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/lg_widget_warning_icon_marginTop" android:layout_marginBottom="@dimen/lg_widget_warning_icon_marginBottom" android:layout_toRightOf="@+id/lg_widget_HL_temp" android:layout_alignTop="@+id/lg_widget_HL_temp" android:layout_alignBottom="@+id/lg_widget_HL_temp" />
        </RelativeLayout>
    </RelativeLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <RelativeLayout android:id="@+id/lg_widget_update_layout" android:layout_width="match_parent" android:layout_height="@dimen/lg_weather_widget_small_underbar_height" android:layout_marginLeft="@dimen/lg_widget_update_layout_large_background_margin" android:layout_marginRight="@dimen/lg_widget_update_layout_large_background_margin" android:layout_marginBottom="@dimen/lg_widget_update_layout_large_background_margin" android:layout_alignParentRight="true" android:layout_alignParentBottom="true">
            <ImageView android:id="@+id/lg_widget_update_layout_background" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@color/lg_widget_update_background" android:scaleType="fitXY" />
            <RelativeLayout android:id="@+id/lg_UpdateButtonLayout" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/lg_mw_UpdateButtonLayout_marginRight" android:layout_alignParentRight="true" android:layout_centerVertical="true">
                <ImageView android:id="@+id/lg_UpdbtnIcon" android:layout_width="wrap_content" android:layout_height="wrap_content" />
                <ProgressBar android:id="@+id/lg_ProgressBarLayoutUpd" android:visibility="gone" android:layout_width="@dimen/lg_ProgressBarMediumLayoutUpd_height" android:layout_height="@dimen/lg_ProgressBarMediumLayoutUpd_height" />
            </RelativeLayout>
            <TextView android:textAppearance="@style/lg_widget_weather_widget_update" android:ellipsize="start" android:gravity="right" android:id="@+id/lg_widget_last_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/lg_weather_medium_last_updated_marginRight" android:layout_marginBottom="@dimen/lg_weather_medium_last_updated_marginBottom" android:maxLines="1" android:scrollHorizontally="true" android:singleLine="true" android:layout_toLeftOf="@+id/lg_UpdateButtonLayout" android:layout_centerVertical="true" android:textColor="#ffffff" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" />
        </RelativeLayout>
        <RelativeLayout android:id="@+id/lg_RelativeLayout01" android:visibility="gone" android:layout_width="match_parent" android:layout_height="match_parent" android:layout_above="@+id/lg_widget_update_layout" />
    </RelativeLayout>
    <RelativeLayout android:layout_width="match_parent" android:layout_height="match_parent">
        <TextView android:id="@+id/lg_widget_weather_logo_bt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginRight="@dimen/lg_ImgButYahoo_marginRight" android:layout_marginBottom="@dimen/lg_ImgButYahoo_small_marginBottom" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" android:text="Open-Meteo.com" android:textSize="10dp" android:textStyle="bold" android:textColor="#ffffff" android:singleLine="true" android:shadowColor="#c0000000" android:shadowDx="1.25" android:shadowDy="2.33" android:shadowRadius="0.5" />
    </RelativeLayout>
    <ImageView android:id="@+id/lg_UpdbtnIcon_touch" android:layout_width="@dimen/lg_UpdbtnIcon_touch_width" android:layout_height="@dimen/lg_UpdbtnIcon_touch_height" android:layout_alignParentRight="true" android:layout_alignParentBottom="true" />
</RelativeLayout>
