<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ntvdm.clockwidgets"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Weather Clock widgets -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <uses-sdk
        android:minSdkVersion="5"
        android:targetSdkVersion="26"
        tools:overrideLibrary="android.support.v7.appcompat, android.support.v4, android.support.mediacompat, android.support.graphics.drawable, android.support.fragment, android.support.coreutils, android.support.coreui, android.support.compat, android.arch.lifecycle" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/Theme.Musti">
        <activity android:name=".MainActivity"
            android:theme="@style/Theme.Musti">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver android:name=".AnalogWidgetProvider" android:label="Custom Clock" android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info" />
        </receiver>

        <receiver android:name=".AnalogWidgetProvider2x2" android:label="Custom Clock 2x2" android:enabled="true" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/widget_info_2x2" />
        </receiver>

        <!-- ============ Weather Clock widgets (Open-Meteo) ============ -->

        <!-- HTC Sense style 4x1. Also the shared receiver for refresh / per-minute tick. -->
        <receiver android:name=".weather.WeatherWidgetProvider" android:label="@string/widget_htc_name" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info_htc" />
        </receiver>

        <receiver android:name=".weather.CleanWidgetProvider" android:label="@string/widget_clean_name" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info_clean" />
        </receiver>

        <receiver android:name=".weather.S4WidgetProvider" android:label="@string/widget_s4_name" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info_s4" />
        </receiver>

        <receiver android:name=".weather.S3WidgetProvider" android:label="@string/widget_s3_name" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info_s3" />
        </receiver>

        <!-- CyanogenMod "Chronus" lock clock. TextClock -> only enabled on 4.2+ -->
        <receiver android:name=".weather.ChronusWidgetProvider" android:label="@string/widget_chronus_name"
            android:enabled="@bool/chronus_enabled" android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.app.action.NEXT_ALARM_CLOCK_CHANGED" />
                <action android:name="android.intent.action.ALARM_CHANGED" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/weather_widget_info_chronus" />
        </receiver>

        <!-- serves the pre-baked rounded/shadowed S3 backgrounds to the launcher -->
        <provider
            android:name=".weather.BackgroundProvider"
            android:authorities="com.ntvdm.clockwidgets.bg"
            android:exported="true" />

    </application>

</manifest>